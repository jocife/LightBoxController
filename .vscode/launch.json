{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Qt App (GDB/LLDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
